<script>
  let activeSource = 'all';
  let activeCorr = 'all-corr';

  function setFilter(val, btn) {
    activeSource = val;
    document.querySelectorAll('.filter-group:first-of-type .filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterEntries();
  }

  function setCorr(val, btn) {
    activeCorr = val;
    document.querySelectorAll('.filter-group:last-of-type .filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterEntries();
  }

  function filterEntries() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const entries = document.querySelectorAll('.entry');
    let visible = 0;

    entries.forEach(e => {
      const sources = e.dataset.sources || '';
      const corr = e.dataset.corr || '0';
      const text = e.textContent.toLowerCase();

      const srcMatch = activeSource === 'all' || sources.includes(activeSource);
      const corrMatch = activeCorr === 'all-corr' || corr === activeCorr;
      const textMatch = !q || text.includes(q);

      if (srcMatch && corrMatch && textMatch) {
        e.classList.remove('hidden');
        visible++;
      } else {
        e.classList.add('hidden');
      }
    });

    document.getElementById('countBadge').textContent = visible + ' entr' + (visible === 1 ? 'y' : 'ies');
    document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';

    // Update category counts
    document.querySelectorAll('.category-section').forEach(section => {
      const cat = section.dataset.category;
      const catEntries = section.querySelectorAll('.entry:not(.hidden)');
      const countEl = document.getElementById('count-' + cat);
      if (countEl) countEl.textContent = catEntries.length + ' visible';
    });
  }

  // Init count
  window.addEventListener('load', filterEntries);
</script>
